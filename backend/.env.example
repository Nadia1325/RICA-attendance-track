# Copy this file to .env and replace every placeholder before starting the backend.
FLASK_DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
CORS_ORIGINS=http://localhost:5173
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30

# Optional SMTP settings enable emailed password reset tokens.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# PASSWORD_RESET_URL_BASE=http://localhost:5173/login

# Set these only when running scripts/seed_admin.py.
# RICA_ADMIN_EMAIL=admin@rica.local
# RICA_ADMIN_USERNAME=admin
# RICA_ADMIN_PASSWORD=replace-with-a-unique-strong-password
